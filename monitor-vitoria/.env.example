# =====================================================================
# monitor-vitoria — configuración
# Copia este archivo a ".env" (cp .env.example .env) y rellena tus claves.
# ".env" está en .gitignore: NUNCA subas tus claves a GitHub.
# =====================================================================

# --- Base de datos -----------------------------------------------------
# Ruta del archivo SQLite (relativa a la carpeta del proyecto o absoluta).
DB_PATH=datos/monitor.db

# --- Ubicación (Vitoria-Gasteiz) --------------------------------------
LATITUD=42.8467
LONGITUD=-2.6716

# --- AEMET OpenData (meteorología) ------------------------------------
# Pide la clave gratis en: https://opendata.aemet.es/centrodedescargas/altaUsuario
# Te llega por email. Es un texto largo (un JWT) que empieza por "eyJ...".
AEMET_API_KEY=
# Estación de observación: 9091R = Vitoria-Gasteiz Aeropuerto (Foronda).
AEMET_ESTACION=9091R

# --- ESIOS / Red Eléctrica (precio PVPC de la luz) --------------------
# Token personal: se pide por email a consultasios@ree.es
# OPCIONAL: si lo dejas vacío se usa la API pública de REData (apidatos.ree.es),
# que no necesita clave. Así puedes empezar sin esperar al token.
ESIOS_TOKEN=

# --- WAQI (calidad del aire) ------------------------------------------
# Token gratis en: https://aqicn.org/data-platform/token/
WAQI_TOKEN=

# --- SAIH Ebro (embalses y ríos) --------------------------------------
# No necesita clave. Ullíbarri (E027) y Urrunaga (E028) ya vienen puestos por defecto.
# Búscalos en https://www.saihebro.com → Tiempo real: el código sale en la
# dirección de la ficha (…/estacion-embalses-E028-urrunaga).
# Estaciones disponibles: ullibarri, urrunaga, zadorra_vitoria, zadorra_arce
# Comprueba cada código con:  python -m monitor_vitoria probar-saih CODIGO
SAIH_CODIGOS=urrunaga=E028,ullibarri=E027

# --- Telegram (alertas) -----------------------------------------------
# 1) Habla con @BotFather en Telegram, crea un bot con /newbot y copia el token.
# 2) Escribe cualquier mensaje a tu bot.
# 3) Abre https://api.telegram.org/bot<TOKEN>/getUpdates y busca "chat":{"id":...}
# Si los dejas vacíos, las alertas solo se escriben en el log (no se envían).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Planificador: cada cuántos minutos se consulta cada fuente -------
# AEMET actualiza cada hora; WAQI cada hora; PVPC publica 1 vez al día (~20:30).
INTERVALO_AEMET_MIN=60
INTERVALO_PVPC_MIN=60
INTERVALO_WAQI_MIN=30
# SAIH publica cada 15 min; 30 es suficiente y respetuoso con su web.
INTERVALO_SAIH_MIN=30
# La generación hidráulica es diaria.
INTERVALO_GENERACION_MIN=360

# --- Umbrales de alerta (déjalo vacío para desactivar una regla) ------
ALERTA_TEMP_MAX=35
ALERTA_TEMP_MIN=-3
ALERTA_VIENTO_RACHA_MS=20
ALERTA_AQI_MAX=100
# Precio en €/kWh
ALERTA_PVPC_BARATO=0.08
ALERTA_PVPC_CARO=0.25
# Embalse por encima de este % de llenado
ALERTA_EMBALSE_PCT=95
# Crecida: caudal del río X veces mayor que su mediana de los últimos 7 días
ALERTA_CRECIDA_FACTOR=3

# --- Panel web ---------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- Log ---------------------------------------------------------------
LOG_LEVEL=INFO
