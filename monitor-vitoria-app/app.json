{
  "expo": {
    "name": "Vitoria",
    "slug": "monitor-vitoria",
    "scheme": "monitorvitoria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "eus.monitorvitoria.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "eus.monitorvitoria.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0d12",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#4f8cff"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Para mostrar dónde estás en el mapa de autobuses, tranvía y tráfico."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "description": "Panel de Vitoria-Gasteiz: tiempo, aire, luz, embalses, ríos, tráfico, autobuses y tranvía."
  }
}
