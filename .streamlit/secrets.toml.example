# Copia este fichero a secrets.toml (en esta misma carpeta) y rellena tus
# propios datos. secrets.toml NUNCA se sube a git (ver .gitignore) — tu
# usuario y contraseña se quedan solo en este PC.
#
# Si no rellenas esta sección, la app funciona igual: simplemente la
# sincronización con Oracle (fugas de fabricación) no estará disponible.

[oracle_ds]
host = "VITSIDIIFDWDS1.VIT.MICHELIN.COM"
puerto = 1521
service_name = "RFDWVIT0"
usuario = "M_J069068_RO"
password = "TU_CONTRASEÑA_AQUI"

# Si no rellenas esta sección, la app funciona igual: simplemente no copia
# nada a la red al guardar cada verificación.
#
# Carpeta de red (p.ej. la unidad "O:" donde antes vivía el Excel) donde se
# copia una copia de la base de datos de este PC cada vez que se guarda una
# verificación. Pensado para cuando cada PC de máquina tiene su propia base
# de datos local: así se puede consolidar o consultar desde otro sitio sin
# montar un servidor central. Usa una ruta UNC si puedes (\\servidor\carpeta)
# en vez de una letra de unidad (O:), porque la letra puede variar según el
# usuario o si la app se ejecuta como servicio.
[copia_red]
carpeta_destino = "O:\\MDV\\copias"
